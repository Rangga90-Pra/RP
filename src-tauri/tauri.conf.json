{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Premi & Solar Sopir Ritase",
  "version": "0.1.0",
  "identifier": "com.triplesindosedulur.premisolar",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Premi & Solar Sopir Ritase",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
